# Local Aegis Command stack. Replace every value before production use.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://aegis_runtime:aegis-runtime-local-only@postgres:5432/aegis
DEFAULT_ORGANIZATION_ID=fcfrd-demo
SEED_DEMO_ON_EMPTY=false
AUTO_CREATE_SCHEMA=false
AUTH_REQUIRED=false
PUBLIC_DEMO_WRITE_ENABLED=false
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
KAFKA_USERNAME=placeholder
KAFKA_PASSWORD=placeholder
KAFKA_TOPIC=ops.events.v1
KAFKA_ALERT_TOPIC=ops.alerts.v1
KAFKA_EVENT_TOPIC=ops.events.v1
KAFKA_AUDIT_TOPIC=ops.audit.v1
KAFKA_SHARED_TOPIC=ops.shared.v1
KAFKA_REPLICATION_FACTOR=1
PIPELINE_PROFILE=optimized
REDIS_URL=redis://redis:6379/0
REDIS_FANOUT_ENABLED=true

OIDC_ISSUER=http://localhost:8080/realms/aegis
OIDC_DISCOVERY_URL=http://keycloak:8080/realms/aegis/.well-known/openid-configuration
OIDC_JWKS_URL=http://keycloak:8080/realms/aegis/protocol/openid-connect/certs
OIDC_AUDIENCE=aegis-api
REALTIME_TICKET_TTL_SECONDS=30

SNOWFLAKE_ACCOUNT=placeholder
SNOWFLAKE_USER=placeholder
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_ROLE=AEGIS_LOADER
SNOWFLAKE_WAREHOUSE=AEGIS_INGEST
SNOWFLAKE_DATABASE=AEGIS_ANALYTICS
SNOWFLAKE_SCHEMA=RAW

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Set to http://localhost:8080/realms/aegis for the local operator profile.
NEXT_PUBLIC_OIDC_AUTHORITY=
NEXT_PUBLIC_OIDC_CLIENT_ID=aegis-dashboard
