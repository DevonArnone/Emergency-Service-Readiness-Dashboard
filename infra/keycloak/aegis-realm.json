{
  "realm": "aegis",
  "enabled": true,
  "displayName": "Aegis Command",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": true,
  "roles": {
    "realm": [
      { "name": "admin" },
      { "name": "duty_officer" },
      { "name": "battalion_chief" },
      { "name": "analyst" },
      { "name": "viewer" },
      { "name": "integration_service" }
    ]
  },
  "clients": [
    {
      "clientId": "aegis-dashboard",
      "name": "Aegis Command Dashboard",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/auth/callback"],
      "webOrigins": ["http://localhost:3000"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000"
      },
      "protocolMappers": [
        {
          "name": "organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization_id",
            "claim.value": "fcfrd-demo",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        },
        {
          "name": "aegis-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "aegis-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "aegis-api",
      "name": "Aegis Command API",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false
    },
    {
      "clientId": "aegis-benchmark",
      "name": "Aegis Benchmark Service",
      "enabled": true,
      "publicClient": false,
      "secret": "aegis-benchmark-local-only",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "protocolMappers": [
        {
          "name": "aegis-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "aegis-api",
            "access.token.claim": "true"
          }
        },
        {
          "name": "organization-id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-hardcoded-claim-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "organization_id",
            "claim.value": "fcfrd-demo",
            "jsonType.label": "String",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "duty.officer",
      "email": "duty.officer@example.invalid",
      "firstName": "Demo",
      "lastName": "Duty Officer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "aegis-local-only", "temporary": false }
      ],
      "realmRoles": ["duty_officer"]
    },
    {
      "username": "analyst",
      "email": "analyst@example.invalid",
      "firstName": "Demo",
      "lastName": "Analyst",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "aegis-local-only", "temporary": false }
      ],
      "realmRoles": ["analyst"]
    },
    {
      "username": "service-account-aegis-benchmark",
      "enabled": true,
      "serviceAccountClientId": "aegis-benchmark",
      "realmRoles": ["integration_service", "viewer"]
    }
  ]
}
